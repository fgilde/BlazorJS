@page "/browser-detect"

<h1>Browser detect</h1>
<p class="lead">
    The <code>&lt;BrowserDetect&gt;</code> component reads everything the browser knows about itself and
    binds it to a <code>BrowserInfo</code>. Architecture and exact OS version arrive a bit later through
    the User-Agent Client Hints API, that is why they have their own callbacks.
</p>

<BrowserDetect @bind-browserInfo="@Info"
               OSArchitectureUpdate="OSArchitectureString"
               OSVersionUpdate="OSUpdateString" />

<div class="card">
    @if (Info == null)
    {
        <p class="lead">Loading browser info...</p>
    }
    else
    {
        <table>
            <thead>
                <tr><th>Property</th><th>Value</th></tr>
            </thead>
            <tbody>
                <tr><td>Browser</td><td>@Info.BrowserName @Info.BrowserVersion</td></tr>
                <tr><td>Engine</td><td>@Info.EngineName @Info.EngineVersion</td></tr>
                <tr><td>Is mobile?</td><td>@Info.IsMobile</td></tr>
                <tr><td>Is Android?</td><td>@Info.IsAndroid</td></tr>
                <tr><td>Is iPhone?</td><td>@Info.IsIPhone</td></tr>
                <tr><td>Is iPad?</td><td>@Info.IsIPad</td></tr>
                <tr><td>Operating system</td><td>@Info.OSName @(OSInfo ?? Info.OSVersion)</td></tr>
                <tr><td>Architecture</td><td>@CPUInfoString</td></tr>
                <tr><td>Screen resolution</td><td>@Info.ScreenResolution</td></tr>
                <tr><td>Time zone</td><td>@Info.TimeZone</td></tr>
                <tr><td>User agent</td><td><span class="mono">@Info.UserAgent</span></td></tr>
            </tbody>
        </table>
    }
</div>

<h2>Usage</h2>
<pre><code>@code_sample</code></pre>

@code {
    public BrowserInfo Info { get; set; }
    public string OSInfo { get; set; } = "";
    public string CPUInfoString { get; set; }

    private const string code_sample = @"<BrowserDetect @bind-browserInfo=""@Info""
               OSArchitectureUpdate=""OSArchitectureString""
               OSVersionUpdate=""OSUpdateString"" />

@code {
    public BrowserInfo Info { get; set; }
}";

    private void OSArchitectureString(string cpu) => CPUInfoString = cpu;

    private void OSUpdateString(string version) => OSInfo = version;
}
