@page "/about"

<h1>About</h1>
<p class="lead">
    This app is the living sample for <b>BlazorJS</b>, a small package for better JavaScript interaction in
    Blazor. Every page here is a feature of the package, running for real.
</p>

<div class="card-grid">
    <div class="card">
        <h3>Documentation</h3>
        <p>The full reference for every component, extension and attribute.</p>
        <a href="https://fgilde.github.io/BlazorJS/" target="_blank">fgilde.github.io/BlazorJS</a>
    </div>
    <div class="card">
        <h3>Source</h3>
        <p>Issues, pull requests and the code of this sample app.</p>
        <a href="https://github.com/fgilde/BlazorJS" target="_blank">github.com/fgilde/BlazorJS</a>
    </div>
    <div class="card">
        <h3>Package</h3>
        <p><code>dotnet add package BlazorJS</code> &mdash; MIT licensed.</p>
        <a href="https://www.nuget.org/packages/BlazorJS" target="_blank">nuget.org/packages/BlazorJS</a>
    </div>
</div>

<h2>Contact &amp; support</h2>
<p class="lead">
    Questions, a bug, an idea for the next version &mdash; or a coffee for the maintainer. Both go straight
    to the project, no account needed.
</p>

<div class="connect-grid">
    <gilde-contact project="fgilde/BlazorJS" widget="contact" inline theme="dark" accent="#a855f7"
                   language="en" title="Contact BlazorJS" width="560" radius="14" padding="24"
                   show-logo="true" show-description="false" show-homepage="true"
                   show-preview-notice="false" show-footer="false"
                   footer-brand="BlazorJS" footer-tagline="gilde.org">Contact BlazorJS</gilde-contact>

    <gilde-support project="fgilde/BlazorJS" widget="support" inline theme="dark" accent="#22d3ee"
                   language="en" title="Support BlazorJS" width="560" radius="14" padding="24"
                   show-logo="true" show-description="false" show-homepage="true"
                   show-preview-notice="false" show-footer="false"
                   footer-brand="BlazorJS" footer-tagline="gilde.org"
                   show-support-hint="false" support-hint-text="You are switching to the respective provider."
                   support-layout="rows" show-support-icons="true"
                   show-support-qr="true">Support BlazorJS</gilde-support>
</div>
